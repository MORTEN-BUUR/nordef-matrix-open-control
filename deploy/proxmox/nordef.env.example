# /etc/nordef/nordef.env — read by nordef-mcp@.service
NORDEF_STATE_DIR=/var/lib/nordef
NORDEF_TENANT=default
NORDEF_AGENT_ID=agent-1
NORDEF_TRUSTED_KEYS=/etc/nordef/trusted-keys.json
NORDEF_LICENSE=/etc/nordef/license.key
NORDEF_LICENSE_KEYS=/etc/nordef/license-keys.json
# Comma-separated input sources the operator trusts (never set by the model):
NORDEF_TRUSTED_SOURCES=
# Pin the release policy fingerprint (nordef-admin fingerprint) to detect on-disk tampering:
NORDEF_POLICY_FINGERPRINT=
